rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'ause0155@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Schema Validators ---
    function isValidUserPublic(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, adminUid) {
      return data.keys().hasAll(['uid', 'email', 'addedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'addedBy', 'createdAt'])
        && data.uid is string && data.uid == adminUid && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.addedBy is string && data.addedBy == request.auth.uid && data.addedBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'slug', 'sortOrder', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'slug', 'description', 'sortOrder', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 80 && data.slug.matches('^[a-z0-9\\-]+$')
        && (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 300))
        && data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['title', 'slug', 'price', 'images', 'affiliateUrl', 'isPinned', 'isPublished', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'title', 'slug', 'price', 'originalPrice', 'discountPercent', 'description',
          'categoryId', 'categoryName', 'images', 'video', 'colors', 'sizes', 'stock',
          'rating', 'specifications', 'affiliateUrl', 'isPinned', 'isPublished',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 180 && data.slug.matches('^[a-z0-9\\-]+$')
        && data.price is number && data.price >= 0 && data.price <= 100000000
        && (!('originalPrice' in data) || data.originalPrice == null || (data.originalPrice is number && data.originalPrice >= 0 && data.originalPrice <= 100000000))
        && (!('discountPercent' in data) || data.discountPercent == null || (data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 100))
        && (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 5000))
        && (!('categoryId' in data) || data.categoryId == null || (data.categoryId is string && data.categoryId.size() <= 128))
        && (!('categoryName' in data) || data.categoryName == null || (data.categoryName is string && data.categoryName.size() <= 80))
        && data.images is list && data.images.size() >= 1 && data.images.size() <= 12 && data.images[0] is string && data.images[0].size() >= 1 && data.images[0].size() <= 1000
        && (!('video' in data) || data.video == null || (data.video is string && data.video.size() <= 1000))
        && (!('colors' in data) || data.colors == null || (data.colors is list && data.colors.size() <= 20 && (data.colors.size() == 0 || data.colors[0] is string)))
        && (!('sizes' in data) || data.sizes == null || (data.sizes is list && data.sizes.size() <= 20 && (data.sizes.size() == 0 || data.sizes[0] is string)))
        && (!('stock' in data) || data.stock == null || (data.stock is number && data.stock >= 0 && data.stock <= 1000000))
        && (!('rating' in data) || data.rating == null || (data.rating is number && data.rating >= 0 && data.rating <= 5))
        && (!('specifications' in data) || data.specifications == null || (data.specifications is list && data.specifications.size() <= 30 && (data.specifications.size() == 0 || data.specifications[0] is map)))
        && data.affiliateUrl is string && data.affiliateUrl.size() >= 1 && data.affiliateUrl.size() <= 1000
        && data.isPinned is bool
        && data.isPublished is bool
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWishlistItem(data, userId, productId) {
      return data.keys().hasAll(['userId', 'productId', 'title', 'slug', 'price', 'affiliateUrl', 'addedAt'])
        && data.keys().hasOnly(['userId', 'productId', 'title', 'slug', 'price', 'image', 'affiliateUrl', 'addedAt'])
        && data.userId is string && data.userId == userId && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.productId is string && data.productId == productId && data.productId.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 180
        && data.price is number && data.price >= 0
        && (!('image' in data) || data.image == null || (data.image is string && data.image.size() <= 1000))
        && data.affiliateUrl is string && data.affiliateUrl.size() >= 1 && data.affiliateUrl.size() <= 1000
        && data.addedAt is timestamp;
    }

    function isValidAnalyticsEvent(data) {
      return data.keys().hasAll(['type', 'path', 'dateKey', 'monthKey', 'createdAt'])
        && data.keys().hasOnly(['type', 'productId', 'productTitle', 'categoryId', 'categoryName', 'path', 'dateKey', 'monthKey', 'createdAt'])
        && data.type in ['site_visit', 'product_view', 'affiliate_click']
        && (!('productId' in data) || data.productId == null || (data.productId is string && data.productId.size() <= 128))
        && (!('productTitle' in data) || data.productTitle == null || (data.productTitle is string && data.productTitle.size() <= 160))
        && (!('categoryId' in data) || data.categoryId == null || (data.categoryId is string && data.categoryId.size() <= 128))
        && (!('categoryName' in data) || data.categoryName == null || (data.categoryName is string && data.categoryName.size() <= 80))
        && data.path is string && data.path.size() >= 1 && data.path.size() <= 300
        && data.dateKey is string && data.dateKey.size() == 10 && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.createdAt == request.time;
    }

    // --- Collection Rules ---

    // Users (Display Profile)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserPublic(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserPublic(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if isValidId(userId) && isAdmin();

      // Isolated PII subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isValidId(userId) && docId == 'info'
          && isVerifiedUser()
          && isOwner(userId)
          && isValidUserPrivate(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && docId == 'info'
          && isVerifiedUser()
          && isOwner(userId)
          && isValidUserPrivate(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(docId) && isAdmin();
      }
    }

    // Trusted Admin Registry
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(adminUid)
        && isBootstrappedAdmin()
        && isValidAdminRecord(incoming(), adminUid)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(adminUid) && isBootstrappedAdmin();
    }

    // Dynamic Categories
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if isValidId(categoryId)
        && isAdmin()
        && isValidCategory(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(categoryId)
        && isAdmin()
        && isValidCategory(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'description', 'sortOrder', 'updatedAt']);
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    // Curated Products
    match /products/{productId} {
      allow get: if isValidId(productId) && (existing().isPublished == true || isAdmin());
      allow list: if resource.data.isPublished == true
        || (isVerifiedUser() && resource.data.createdBy == request.auth.uid)
        || isBootstrappedAdmin();
      allow create: if isValidId(productId)
        && isAdmin()
        && isValidProduct(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(productId)
        && isAdmin()
        && isValidProduct(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'slug', 'price', 'originalPrice', 'discountPercent', 'description',
          'categoryId', 'categoryName', 'images', 'video', 'colors', 'sizes', 'stock',
          'rating', 'specifications', 'affiliateUrl', 'isPinned', 'isPublished', 'updatedAt'
        ]);
      allow delete: if isValidId(productId) && isAdmin();
    }

    // Synchronized User Wishlists
    match /wishlists/{userId}/items/{productId} {
      allow get: if isValidId(userId) && isValidId(productId) && isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isValidId(userId) && isValidId(productId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidWishlistItem(incoming(), userId, productId)
        && incoming().addedAt == request.time
        && exists(/databases/$(database)/documents/products/$(productId));
      allow update: if false;
      allow delete: if isValidId(userId) && isValidId(productId) && isOwner(userId);
    }

    // Storefront & Affiliate Telemetry
    match /analytics/{eventId} {
      allow get: if isValidId(eventId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(eventId) && isValidAnalyticsEvent(incoming());
      allow update: if false;
      allow delete: if isValidId(eventId) && isAdmin();
    }
  }
}
