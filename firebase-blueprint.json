{
  "entities": {
    "UserPublic": {
      "title": "UserPublic",
      "description": "Public display profile for an authenticated TRT Finds member.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private PII record isolated from public reads.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized administrator registry entry.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 200 },
        "addedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "addedBy", "createdAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Storefront product category managed dynamically by administrators.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9\\-]+$" },
        "description": { "type": "string", "maxLength": 300 },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "sortOrder", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Curated e-commerce / affiliate product listing.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 180, "pattern": "^[a-z0-9\\-]+$" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "discountPercent": { "type": "number" },
        "description": { "type": "string", "maxLength": 5000 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "categoryName": { "type": "string", "maxLength": 80 },
        "images": { "type": "array" },
        "video": { "type": "string", "maxLength": 1000 },
        "colors": { "type": "array" },
        "sizes": { "type": "array" },
        "stock": { "type": "number" },
        "rating": { "type": "number" },
        "specifications": { "type": "array" },
        "affiliateUrl": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "isPinned": { "type": "boolean" },
        "isPublished": { "type": "boolean" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "slug", "price", "images", "affiliateUrl", "isPinned", "isPublished", "createdBy", "createdAt", "updatedAt"]
    },
    "WishlistItem": {
      "title": "WishlistItem",
      "description": "Saved product reference in an authenticated user's wishlist.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 180 },
        "price": { "type": "number" },
        "image": { "type": "string", "maxLength": 1000 },
        "affiliateUrl": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "productId", "title", "slug", "price", "affiliateUrl", "addedAt"]
    },
    "AnalyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "Privacy-preserving storefront visit, product view, or outbound affiliate click telemetry event.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["site_visit", "product_view", "affiliate_click"] },
        "productId": { "type": "string", "maxLength": 128 },
        "productTitle": { "type": "string", "maxLength": 160 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "categoryName": { "type": "string", "maxLength": 80 },
        "path": { "type": "string", "minLength": 1, "maxLength": 300 },
        "dateKey": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "monthKey": { "type": "string", "minLength": 7, "maxLength": 7, "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "path", "dateKey", "monthKey", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Member display profiles."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Isolated PII storage for authenticated user emails."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted administrator lookup collection."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Dynamic storefront categories."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Curated product catalog."
    },
    "/wishlists/{userId}/items/{productId}": {
      "schema": { "$ref": "#/entities/WishlistItem" },
      "description": "Per-user synchronized wishlist items."
    },
    "/analytics/{eventId}": {
      "schema": { "$ref": "#/entities/AnalyticsEvent" },
      "description": "Storefront traffic and outbound affiliate click events."
    }
  }
}
